# Copiar a .env.local y completar. Los valores reales viven en Vercel (Settings → Environment Variables).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor. Hoy la app no la usa; está en Vercel para scripts.
SUPABASE_SERVICE_ROLE_KEY=
# Solo servidor: lectura de fotos de tarjetas.
ANTHROPIC_API_KEY=
# Opcional: modelo de visión (default claude-sonnet-5).
GALF_VISION_MODEL=
# Opcional: "1" habilita /dev/playground en un build de producción local. En Vercel ya se
# habilita solo en los deploys Preview (VERCEL_ENV=preview); nunca en producción.
GALF_PLAYGROUND=
# Opcional: "1" prueba el truco de vibración en iOS (checkbox switch, Safari 17.4+). Apagado por defecto.
NEXT_PUBLIC_GALF_IOS_HAPTICS=
